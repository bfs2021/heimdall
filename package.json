{
  "name": "@tinkermonkey/heimdall-ui",
  "version": "0.8.0",
  "description": "Heimdall design system component library",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinkermonkey/heimdall.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "agent-skills"
  ],
