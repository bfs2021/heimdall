      "default": "./dist/fonts/fonts.css"
    }
  },
  "scripts": {
    "prepare": "vite build",
    "build": "vite build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest",
    "dev": "vite",
    "lint": "eslint src/ docs/src/ --ext .ts,.tsx",
    "setup": "node scripts/download-fonts.js"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "d3-hierarchy": "^3.1.2",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/forms": "^0.5.7",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^14.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.0"
